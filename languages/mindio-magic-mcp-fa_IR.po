msgstr "کاربر وردپرس شما اجازهٔ ویرایش این نوشته را ندارد."

#: includes/tools/class-automation-tools.php:297
msgid "Your WordPress user cannot publish this post."
msgstr "کاربر وردپرس شما اجازهٔ انتشار این نوشته را ندارد."

#: includes/tools/class-automation-tools.php:309
