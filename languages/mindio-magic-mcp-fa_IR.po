#: includes/tools/class-automation-tools.php:244
msgid "The automation provider returned an invalid translation payload."
msgstr "ارائه‌دهندهٔ خودکارسازی دادهٔ نامعتبری برای ترجمه برگرداند."

#: includes/tools/class-automation-tools.php:247
msgid "The translated title or content exceeds the allowed size."
